<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Delivery">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="inventoryStockStatus" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefrontInventory\Model\Document\Writer\Stock</item>
                </item>
            </argument>
            <argument name="identities" xsi:type="array">
                <item name="inventoryStockStatus" xsi:type="array">
                    <item name="cat_p" xsi:type="array">
                        <item name="productId" xsi:type="string">productId</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Model\Feeds">
        <arguments>
            <argument name="feeds" xsi:type="array">
                <item name="product" xsi:type="array">
                    <item name="inventory_data_exporter_stock_status" xsi:type="object">Magento\InventoryDataExporter\Model\Indexer\StockStatusFeedIndexMetadata</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- A deleted row keeps the websites of its stock, so the writer drops the slice in those store views only. -->
    <virtualType name="Magento\InventoryDataExporter\Model\Indexer\StockStatusFeedIndexMetadata">
        <arguments>
            <argument name="minimalPayload" xsi:type="array">
                <item name="websiteCodes" xsi:type="string">websiteCodes</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="GraphCommerce\CatalogStorefront\Model\Registry\NativeResources"><plugin name="catalog_registry_native_stocks" type="GraphCommerce\CatalogStorefrontInventory\Plugin\Registry\NativeStocks"/></type>
    <type name="GraphCommerce\CatalogStorefront\Model\Registry\Options"><plugin name="catalog_registry_stock_options" type="GraphCommerce\CatalogStorefrontInventory\Plugin\Registry\NativeStocks"/></type>
</config>
