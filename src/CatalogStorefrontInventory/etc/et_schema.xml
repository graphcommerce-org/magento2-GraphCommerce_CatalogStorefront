<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="StockItemStatus">
        <field name="minQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="minSaleQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="maxSaleQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="websiteCodes" type="String" repeated="true" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockWebsites">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
    </record>
</config>
