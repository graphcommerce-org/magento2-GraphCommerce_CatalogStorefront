<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Mview/etc/mview.xsd">
    <!-- A configurable link change re-exports the parent, whose row names its children. The child comes
         along through the catalog_product_relation subscription of the exporter's own products feed. -->
    <view id="cde_products_feed" class="Magento\CatalogDataExporter\Model\Indexer\ProductFeedIndexer" group="indexer">
        <subscriptions>
            <table name="catalog_product_super_link" entity_column="parent_id"/>
        </subscriptions>
    </view>
</config>
