<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="Link">
        <field name="position" type="Int"/>
    </record>
    <record name="ProductCustomAttribute">
        <field name="attributeCode" type="String"/>
        <field name="value" type="String"/>
    </record>
    <record name="Product">
        <field name="attributeSetId" type="Int" provider="GraphCommerce\CatalogStorefront\Model\Feed\AttributeSetProvider">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="customAttributes" type="ProductCustomAttribute" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\Feed\CustomAttributesProvider">
            <using field="productId"/>
            <using field="storeViewCode"/>
            <using field="type"/>
        </field>
    </record>
    <record name="Category">
        <field name="filterPriceRange" type="String" provider="GraphCommerce\CatalogStorefront\Model\Feed\CategoryPriceStepProvider">
            <using field="categoryId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="productCount" type="Int" provider="GraphCommerce\CatalogStorefront\Model\Feed\CategoryProductCountProvider">
            <using field="categoryId"/>
            <using field="storeViewCode"/>
        </field>
    </record>
    <record name="ProductAttributeOption">
        <field name="id" type="ID"/>
        <field name="label" type="String"/>
    </record>
    <record name="ProductAttributeMetadata">
        <field name="attributeId" type="Int" provider="GraphCommerce\CatalogStorefront\Model\Feed\AttributeLayerProvider">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="options" type="ProductAttributeOption" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\Feed\AttributeOptionsProvider">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="position" type="Int" provider="GraphCommerce\CatalogStorefront\Model\Feed\AttributeLayerProvider">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="filterableMode" type="Int" provider="GraphCommerce\CatalogStorefront\Model\Feed\AttributeLayerProvider">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
    </record>
</config>
