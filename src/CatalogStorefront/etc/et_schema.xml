<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="Link">
        <field name="position" type="Int"/>
    </record>
    <record name="ProductCustomAttribute">
        <field name="attributeCode" type="String"/>
        <field name="value" type="String"/>
    </record>
    <record name="Product">
        <field name="attributeSetId" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\EntityData">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="hasOptions" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\EntityData">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="requiredOptions" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\EntityData">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="customAttributes" type="ProductCustomAttribute" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\CustomAttributes">
            <using field="productId"/>
            <using field="storeViewCode"/>
            <using field="type"/>
        </field>
        <field name="websiteIds" type="Int" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\Websites">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="taxClassId" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\TaxClass">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="imageUrls" type="ProductImageUrls" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\ImageUrls">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
    </record>
    <record name="MediaItem">
        <field name="imageUrl" type="ProductImageUrl"/>
    </record>
    <record name="ProductImageUrl" skipNull="true">
        <field name="mediaPath" type="String"/>
        <field name="placeholder" type="Boolean"/>
    </record>
    <record name="ProductImageUrls" skipNull="true">
        <field name="image" type="ProductImageUrl"/>
        <field name="small_image" type="ProductImageUrl"/>
        <field name="thumbnail" type="ProductImageUrl"/>
    </record>
    <record name="CategoryCustomAttribute">
        <field name="attributeCode" type="String"/>
        <field name="value" type="String"/>
    </record>
    <record name="Category">
        <field name="customAttributes" type="CategoryCustomAttribute" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\CategoryCustomAttributes">
            <using field="categoryId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="filterPriceRange" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\CategoryPriceStep">
            <using field="categoryId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="productCount" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\CategoryProductCount">
            <using field="categoryId"/>
            <using field="storeViewCode"/>
        </field>
    </record>
    <record name="ProductImagePlaceholders" skipNull="true">
        <field name="image" type="String"/>
        <field name="small_image" type="String"/>
        <field name="thumbnail" type="String"/>
    </record>
    <record name="StoreViewMedia">
        <field name="storeViewCode" type="String"/>
        <field name="mediaBaseUrl" type="String"/>
        <field name="imagePlaceholders" type="ProductImagePlaceholders"/>
    </record>
    <record name="Website">
        <field name="storeViewMedia" type="StoreViewMedia" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\StoreViewMedia">
            <using field="websiteId"/>
        </field>
    </record>
    <record name="Export">
        <field name="scopesWebsite" type="Website" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Processor\Scopes">
            <using field="websiteId"/>
        </field>
        <field name="scopesCustomerGroup" type="CustomerGroup" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Processor\Scopes">
            <using field="customerGroupId"/>
        </field>
    </record>
    <record name="ProductPriceV2">
        <field name="final" type="Float" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\FinalPrice">
            <using field="productPriceId"/>
        </field>
        <field name="precision" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\FinalPrice">
            <using field="productPriceId"/>
        </field>
    </record>
    <record name="CustomerGroup">
        <field name="name" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\CustomerGroupName">
            <using field="customerGroupId"/>
        </field>
    </record>
    <record name="ProductAttributeOption">
        <field name="id" type="ID"/>
        <field name="label" type="String"/>
        <field name="facetSortOrder" type="Int"/>
    </record>
    <record name="ProductAttributeMetadata">
        <field name="attributeId" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="options" type="ProductAttributeOption" repeated="true" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeOptions">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="position" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="filterableMode" type="Int" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="frontendClass" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="defaultValue" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="htmlAllowedOnFront" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="wysiwygEnabled" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="usedForPromoRules" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="visibleInAdvancedSearch" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="applyTo" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="additionalData" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="isVisible" type="Boolean" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
        <field name="backendType" type="String" provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\AttributeLayer">
            <using field="id"/>
            <using field="storeViewCode"/>
        </field>
    </record>
</config>
