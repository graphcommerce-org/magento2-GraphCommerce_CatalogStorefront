<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\DataExporter\Model\ExportFeedInterface" type="GraphCommerce\CatalogStorefront\Model\Document\Delivery"/>
    <preference for="GraphCommerce\CatalogStorefrontApi\Read\ProductDocumentsInterface" type="GraphCommerce\CatalogStorefront\Model\Read\ProductDocuments"/>

    <type name="Magento\CatalogDataExporter\Model\Provider\Product\MediaGallery">
        <plugin name="graphcommerce_catalog_storefront_gallery_image_urls" type="GraphCommerce\CatalogStorefront\Model\DataExporter\Provider\ImageUrls"/>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="catalog_storefront_rebuild" xsi:type="object">GraphCommerce\CatalogStorefront\Console\Command\Rebuild</item>
                <item name="catalog_storefront_status" xsi:type="object">GraphCommerce\CatalogStorefront\Console\Command\Status</item>
            </argument>
        </arguments>
    </type>
    <!-- The feeds that write each entity, metadata first because a product row names it;
         a module adds the feeds it writes. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Feeds">
        <arguments>
            <argument name="feeds" xsi:type="array">
                <item name="attribute" xsi:type="array">
                    <item name="catalog_data_exporter_product_attributes" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\ProductAttributeFeedIndexMetadata</item>
                </item>
                <item name="category" xsi:type="array">
                    <item name="catalog_data_exporter_categories" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\CategoryFeedIndexMetadata</item>
                </item>
                <item name="product" xsi:type="array">
                    <item name="catalog_data_exporter_products" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\ProductFeedIndexMetadata</item>
                    <item name="catalog_data_exporter_product_prices" xsi:type="object">Magento\ProductPriceDataExporter\Model\Indexer\ProductPriceFeedIndexMetadata</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- The feeds of the scope documents, which a rebuild exports again before any entity. -->
    <type name="GraphCommerce\CatalogStorefront\Console\Command\Rebuild">
        <arguments>
            <argument name="scopeFeeds" xsi:type="array">
                <item name="website" xsi:type="array">
                    <item name="scopes_website_data_exporter" xsi:type="object">Magento\ScopesDataExporter\Model\Indexer\ScopesWebsiteFeedIndexMetadata</item>
                </item>
                <item name="customer_group" xsi:type="array">
                    <item name="scopes_customergroup_data_exporter" xsi:type="object">Magento\ScopesDataExporter\Model\Indexer\ScopesCustomerGroupFeedIndexMetadata</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Write side: the writers of each feed, called in registration order. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Delivery">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="products" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Products</item>
                </item>
                <item name="prices" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Prices</item>
                </item>
                <item name="categories" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Categories</item>
                </item>
                <item name="productAttributes" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Attributes</item>
                </item>
                <item name="scopesWebsite" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Websites</item>
                </item>
                <item name="scopesCustomerGroup" xsi:type="array">
                    <item name="documents" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\CustomerGroups</item>
                </item>
            </argument>
            <!-- The configuration flag of each writer family; a family without one always writes. -->
            <argument name="flags" xsi:type="array">
                <item name="documents" xsi:type="const">GraphCommerce\CatalogStorefront\Model\Config::INDEX_ENABLED</item>
            </argument>
            <!-- The cache tags a feed batch purges after its write: cat_p is the product tag, cat_c the category tag. -->
            <argument name="identities" xsi:type="array">
                <item name="products" xsi:type="array">
                    <item name="cat_p" xsi:type="array">
                        <item name="productId" xsi:type="string">productId</item>
                    </item>
                </item>
                <item name="prices" xsi:type="array">
                    <item name="cat_p" xsi:type="array">
                        <item name="productId" xsi:type="string">productId</item>
                    </item>
                </item>
                <item name="categories" xsi:type="array">
                    <item name="cat_c" xsi:type="array">
                        <item name="categoryId" xsi:type="string">categoryId</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- A `using` node merges by its field name, so a field this package gives a provider keeps every key of
         its lookup; without it two `using` nodes of one field share a path and the last one stands alone. -->
    <virtualType name="Magento\DataExporter\Config\Reader">
        <arguments>
            <argument name="idAttributes" xsi:type="array">
                <item name="/config/record/field/using" xsi:type="string">field</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- The scopes feeds are delivered like the catalog feeds: during indexing, keyed like the modern feed tables. -->
    <virtualType name="Magento\ScopesDataExporter\Model\Indexer\ScopesWebsiteFeedIndexMetadata">
        <arguments>
            <argument name="feedTableField" xsi:type="string">source_entity_id</argument>
            <argument name="exportImmediately" xsi:type="boolean">true</argument>
            <argument name="persistExportedFeed" xsi:type="init_parameter">Magento\DataExporter\Model\ExportFeedInterface::PERSIST_EXPORTED_FEED</argument>
            <argument name="minimalPayload" xsi:type="array">
                <item name="websiteId" xsi:type="string">websiteId</item>
            </argument>
            <argument name="feedItemIdentifiers" xsi:type="array">
                <item name="websiteId" xsi:type="string">websiteId</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\ScopesDataExporter\Model\Indexer\ScopesCustomerGroupFeedIndexMetadata">
        <arguments>
            <argument name="feedTableField" xsi:type="string">source_entity_id</argument>
            <argument name="exportImmediately" xsi:type="boolean">true</argument>
            <argument name="persistExportedFeed" xsi:type="init_parameter">Magento\DataExporter\Model\ExportFeedInterface::PERSIST_EXPORTED_FEED</argument>
            <argument name="minimalPayload" xsi:type="array">
                <item name="customerGroupId" xsi:type="string">customerGroupId</item>
            </argument>
            <argument name="feedItemIdentifiers" xsi:type="array">
                <item name="customerGroupId" xsi:type="string">customerGroupId</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- The legacy scopes serializers map the plain row; immediate export hands over the generic shape. -->
    <virtualType name="Magento\ScopesDataExporter\Model\Indexer\ScopesWebsiteFeedIndexer">
        <arguments>
            <argument name="serializer" xsi:type="object">Magento\DataExporter\Model\Indexer\DataSerializer</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\ScopesDataExporter\Model\Indexer\ScopesCustomerGroupFeedIndexer">
        <arguments>
            <argument name="serializer" xsi:type="object">Magento\DataExporter\Model\Indexer\DataSerializer</argument>
        </arguments>
    </virtualType>
    <!-- A new customer group re-exports the prices feed, so every price index gets the group's entry. -->
    <type name="Magento\Customer\Api\GroupRepositoryInterface">
        <plugin name="graphcommerce_catalog_storefront_prices_feed_on_new_group" type="GraphCommerce\CatalogStorefront\Plugin\Customer\PricesFeedOnNewGroup"/>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Plugin\Customer\PricesFeedOnNewGroup">
        <arguments>
            <argument name="feed" xsi:type="object">Magento\ProductPriceDataExporter\Model\Indexer\ProductPriceFeedIndexMetadata</argument>
            <argument name="indexerId" xsi:type="string">catalog_data_exporter_product_prices</argument>
        </arguments>
    </type>
    <type name="Magento\CatalogDataExporter\Model\Provider\Product\Links">
        <plugin name="graphcommerce_catalog_storefront_link_position" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\LinkPosition"/>
    </type>
    <type name="Magento\CatalogDataExporter\Model\Provider\Category\DefaultSortBy">
        <plugin name="graphcommerce_catalog_storefront_category_default_sort_by" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\CategoryDefaultSortBy"/>
    </type>
    <type name="Magento\ProductPriceDataExporter\Model\Provider\ProductPrice">
        <plugin name="graphcommerce_catalog_storefront_tier_price_percent" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\TierPricePercent"/>
    </type>

    <!-- The product documents: filtered and aggregated on sku, type, parents, status, salability and the
         nested price index (one entry per customer group). The category documents: filtered by id, url key,
         url path and parent, sorted by position. -->
    <type name="GraphCommerce\CatalogStorefrontApi\Storage\EntityMappings">
        <arguments>
            <argument name="mappings" xsi:type="array">
                <item name="product" xsi:type="array">
                    <item name="sku" xsi:type="string">keyword</item>
                    <item name="type" xsi:type="string">keyword</item>
                    <item name="parentIds" xsi:type="string">keyword</item>
                    <item name="groupedParentIds" xsi:type="string">keyword</item>
                    <item name="bundleParentIds" xsi:type="string">keyword</item>
                    <item name="status" xsi:type="string">keyword</item>
                    <item name="stock.isSalable" xsi:type="string">boolean</item>
                    <item name="taxClassId" xsi:type="string">keyword</item>
                    <item name="priceIndex" xsi:type="array">
                        <item name="type" xsi:type="string">nested</item>
                        <item name="fields" xsi:type="array">
                            <item name="group" xsi:type="string">keyword</item>
                            <item name="regular" xsi:type="string">double</item>
                            <item name="final" xsi:type="string">double</item>
                        </item>
                    </item>
                </item>
                <item name="category" xsi:type="array">
                    <item name="id" xsi:type="string">integer</item>
                    <item name="parentId" xsi:type="string">keyword</item>
                    <item name="urlKey" xsi:type="string">keyword</item>
                    <item name="urlPath" xsi:type="string">keyword</item>
                    <item name="position" xsi:type="string">integer</item>
                    <item name="isActive" xsi:type="string">integer</item>
                    <item name="level" xsi:type="string">integer</item>
                    <item name="name" xsi:type="string">keyword</item>
                    <item name="path" xsi:type="string">keyword</item>
                    <item name="children" xsi:type="string">integer</item>
                </item>
                <item name="attribute" xsi:type="array">
                    <item name="id" xsi:type="string">keyword</item>
                    <item name="attributeId" xsi:type="string">integer</item>
                    <item name="frontendInput" xsi:type="string">keyword</item>
                    <item name="filterableMode" xsi:type="string">integer</item>
                    <item name="filterableInSearch" xsi:type="string">boolean</item>
                    <item name="visible" xsi:type="string">boolean</item>
                    <item name="position" xsi:type="string">integer</item>
                    <item name="options.id" xsi:type="string">keyword</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\ProductLink\ProductLinkQuery">
        <plugin name="graphcommerce_catalog_storefront_product_links" type="GraphCommerce\CatalogStorefront\Plugin\ProductLinksFromDocuments"/>
    </type>
    <type name="Magento\Catalog\Model\Layer\Filter\Price\Range">
        <plugin name="graphcommerce_catalog_storefront_price_step" type="GraphCommerce\CatalogStorefront\Plugin\Layer\PriceRangeStepFromDocument"/>
    </type>
    <!-- The `single` price navigation step calculation: one range, served from the search response.
         The array replaces the one app/etc/di.xml declares, so core's three travel with it. -->
    <type name="Magento\Framework\Search\Dynamic\Algorithm\Repository">
        <arguments>
            <argument name="algorithms" xsi:type="array">
                <item name="auto" xsi:type="string">Magento\Framework\Search\Dynamic\Algorithm\Auto</item>
                <item name="manual" xsi:type="string">Magento\Framework\Search\Dynamic\Algorithm\Manual</item>
                <item name="improved" xsi:type="string">Magento\Framework\Search\Dynamic\Algorithm\Improved</item>
                <item name="single" xsi:type="string">GraphCommerce\CatalogStorefront\Model\Layer\SingleRange</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\Aggregation\Builder\Dynamic">
        <plugin name="graphcommerce_catalog_storefront_single_price_range" type="GraphCommerce\CatalogStorefront\Plugin\Layer\SingleRangeFromResponse"/>
    </type>
    <!-- A save of the out of stock display setting rebuilds the categories feed too: the category count reads it. -->
    <type name="Magento\DataExporter\Service\IndexInvalidationManager">
        <arguments>
            <argument name="invalidationEvents" xsi:type="array">
                <item name="stock_display_config_changed" xsi:type="array">
                    <item name="products" xsi:type="string">catalog_data_exporter_products</item>
                    <item name="categories" xsi:type="string">catalog_data_exporter_categories</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\CatalogDataExporter\Plugin\Index\InvalidateOnConfigChange">
        <arguments>
            <argument name="configPathToEvent" xsi:type="array">
                <item name="cataloginventory/options/show_out_of_stock" xsi:type="string">stock_display_config_changed</item>
            </argument>
        </arguments>
    </type>
    <preference for="GraphCommerce\CatalogStorefrontApi\Registry\ResourceRepositoryInterface" type="GraphCommerce\CatalogStorefront\Model\Registry\ReadOnlyConfiguration"/>
    <preference for="GraphCommerce\CatalogStorefrontApi\Service\ConfigurationInterface" type="GraphCommerce\CatalogStorefront\Model\Registry\ReadOnlyConfiguration"/>
    <preference for="GraphCommerce\CatalogStorefrontApi\Service\SourceMetadataInterface" type="GraphCommerce\CatalogStorefront\Model\Registry\UnavailableSourceMetadata"/>
</config>
