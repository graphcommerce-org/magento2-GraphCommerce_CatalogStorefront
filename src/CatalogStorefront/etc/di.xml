<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\DataExporter\Model\ExportFeedInterface" type="GraphCommerce\CatalogStorefront\Model\Document\Delivery"/>
    <preference for="GraphCommerce\CatalogStorefrontApi\Read\ProductDocumentsInterface" type="GraphCommerce\CatalogStorefront\Model\Read\ProductDocuments"/>

    <!-- Write side: one writer per feed, the products feed run through the document fields. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Delivery">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="products" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Products</item>
                <item name="prices" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Prices</item>
                <item name="categories" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Categories</item>
                <item name="productAttributes" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Attributes</item>
            </argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Writer\Products">
        <arguments>
            <argument name="fields" xsi:type="array">
                <item name="imageUrls" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Field\ImageUrls</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\CatalogDataExporter\Model\Provider\Product\Links">
        <plugin name="graphcommerce_catalog_storefront_link_position" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\LinkPosition"/>
    </type>
    <type name="Magento\ProductPriceDataExporter\Model\Provider\ProductPrice">
        <plugin name="graphcommerce_catalog_storefront_tier_price_percent" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\TierPricePercent"/>
    </type>

    <!-- Read side shared by every frontend. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Read\PriceRanges">
        <arguments>
            <argument name="ranges" xsi:type="array">
                <item name="simple" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Read\Price\SingleRange</item>
                <item name="virtual" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Read\Price\SingleRange</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\ProductLink\ProductLinkQuery">
        <plugin name="graphcommerce_catalog_storefront_product_links" type="GraphCommerce\CatalogStorefront\Plugin\ProductLinksFromDocuments"/>
    </type>
    <type name="Magento\Catalog\Model\Layer\Filter\Price\Range">
        <plugin name="graphcommerce_catalog_storefront_price_step" type="GraphCommerce\CatalogStorefront\Plugin\Layer\PriceRangeStepFromDocument"/>
    </type>
    <type name="Magento\Elasticsearch\Model\Adapter\FieldMapper\FieldMapperResolver">
        <plugin name="graphcommerce_catalog_storefront_field_name_memo" type="GraphCommerce\CatalogStorefront\Plugin\Search\FieldNameMemo"/>
    </type>
    <type name="Magento\Search\Model\Query">
        <plugin name="graphcommerce_catalog_storefront_search_term_recording" type="GraphCommerce\CatalogStorefront\Plugin\Search\SearchTermRecording"/>
    </type>
    <type name="Magento\Deploy\Model\DeploymentConfig\ChangeDetector">
        <plugin name="graphcommerce_catalog_storefront_config_change_memo" type="GraphCommerce\CatalogStorefront\Plugin\Deploy\ConfigChangeMemo"/>
    </type>
</config>
