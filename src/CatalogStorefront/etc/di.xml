<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\DataExporter\Model\ExportFeedInterface" type="GraphCommerce\CatalogStorefront\Model\Document\Delivery"/>
    <preference for="GraphCommerce\CatalogStorefrontApi\Read\ProductDocumentsInterface" type="GraphCommerce\CatalogStorefront\Model\Read\ProductDocuments"/>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="catalog_storefront_rebuild" xsi:type="object">GraphCommerce\CatalogStorefront\Console\Command\Rebuild</item>
            </argument>
        </arguments>
    </type>
    <!-- The feeds a rebuild of an entity re-exports; a module adds the feeds it writes. -->
    <type name="GraphCommerce\CatalogStorefront\Console\Command\Rebuild">
        <arguments>
            <argument name="feeds" xsi:type="array">
                <item name="product" xsi:type="array">
                    <item name="catalog_data_exporter_products" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\ProductFeedIndexMetadata</item>
                    <item name="catalog_data_exporter_product_prices" xsi:type="object">Magento\ProductPriceDataExporter\Model\Indexer\ProductPriceFeedIndexMetadata</item>
                </item>
                <item name="category" xsi:type="array">
                    <item name="catalog_data_exporter_categories" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\CategoryFeedIndexMetadata</item>
                </item>
                <item name="attribute" xsi:type="array">
                    <item name="catalog_data_exporter_product_attributes" xsi:type="object">Magento\CatalogDataExporter\Model\Indexer\ProductAttributeFeedIndexMetadata</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Write side: one writer per feed, the products feed run through the document fields. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Delivery">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="products" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Products</item>
                <item name="prices" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Prices</item>
                <item name="categories" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Categories</item>
                <item name="productAttributes" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Writer\Attributes</item>
            </argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Model\Document\Writer\Products">
        <arguments>
            <argument name="fields" xsi:type="array">
                <item name="imageUrls" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Field\ImageUrls</item>
                <item name="taxClassId" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Document\Field\TaxClassId</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\CatalogDataExporter\Model\Provider\Product\Links">
        <plugin name="graphcommerce_catalog_storefront_link_position" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\LinkPosition"/>
    </type>
    <type name="Magento\CatalogDataExporter\Model\Provider\Category\DefaultSortBy">
        <plugin name="graphcommerce_catalog_storefront_category_default_sort_by" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\CategoryDefaultSortBy"/>
    </type>
    <type name="Magento\ProductPriceDataExporter\Model\Provider\ProductPrice">
        <plugin name="graphcommerce_catalog_storefront_tier_price_percent" type="GraphCommerce\CatalogStorefront\Plugin\DataExporter\TierPricePercent"/>
    </type>

    <!-- The product documents: filtered and aggregated on sku, type, parents, status, salability and the
         nested price index (one entry per customer group). The category documents: filtered by id, url key,
         url path and parent, sorted by position. -->
    <type name="GraphCommerce\CatalogStorefrontApi\Storage\EntityMappings">
        <arguments>
            <argument name="mappings" xsi:type="array">
                <item name="product" xsi:type="array">
                    <item name="sku" xsi:type="string">keyword</item>
                    <item name="type" xsi:type="string">keyword</item>
                    <item name="parentIds" xsi:type="string">keyword</item>
                    <item name="groupedParentIds" xsi:type="string">keyword</item>
                    <item name="bundleParentIds" xsi:type="string">keyword</item>
                    <item name="status" xsi:type="string">keyword</item>
                    <item name="stock.isSalable" xsi:type="string">boolean</item>
                    <item name="priceIndex" xsi:type="array">
                        <item name="type" xsi:type="string">nested</item>
                        <item name="fields" xsi:type="array">
                            <item name="group" xsi:type="string">keyword</item>
                            <item name="regular" xsi:type="string">float</item>
                            <item name="final" xsi:type="string">float</item>
                        </item>
                    </item>
                </item>
                <item name="category" xsi:type="array">
                    <item name="id" xsi:type="string">integer</item>
                    <item name="parentId" xsi:type="string">keyword</item>
                    <item name="urlKey" xsi:type="string">keyword</item>
                    <item name="urlPath" xsi:type="string">keyword</item>
                    <item name="position" xsi:type="string">integer</item>
                    <item name="isActive" xsi:type="string">integer</item>
                    <item name="level" xsi:type="string">integer</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Read side shared by every frontend. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Read\PriceRanges">
        <arguments>
            <argument name="ranges" xsi:type="array">
                <item name="simple" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Read\Price\SingleRange</item>
                <item name="virtual" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Read\Price\SingleRange</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\ProductLink\ProductLinkQuery">
        <plugin name="graphcommerce_catalog_storefront_product_links" type="GraphCommerce\CatalogStorefront\Plugin\ProductLinksFromDocuments"/>
    </type>
    <type name="Magento\Catalog\Model\Layer\Filter\Price\Range">
        <plugin name="graphcommerce_catalog_storefront_price_step" type="GraphCommerce\CatalogStorefront\Plugin\Layer\PriceRangeStepFromDocument"/>
    </type>
    <!-- The `single` price navigation step calculation: one range, served from the search response. -->
    <type name="Magento\Framework\Search\Dynamic\Algorithm\Repository">
        <arguments>
            <argument name="algorithms" xsi:type="array">
                <item name="single" xsi:type="string">GraphCommerce\CatalogStorefront\Model\Layer\SingleRange</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\Aggregation\Builder\Dynamic">
        <plugin name="graphcommerce_catalog_storefront_single_price_range" type="GraphCommerce\CatalogStorefront\Plugin\Layer\SingleRangeFromResponse"/>
    </type>
    <type name="Magento\Elasticsearch\Model\Adapter\FieldMapper\FieldMapperResolver">
        <plugin name="graphcommerce_catalog_storefront_field_name_memo" type="GraphCommerce\CatalogStorefront\Plugin\Search\FieldNameMemo"/>
    </type>
    <type name="Magento\Framework\DB\Adapter\Pdo\Mysql">
        <plugin name="graphcommerce_catalog_storefront_statement_recorder" type="GraphCommerce\CatalogStorefront\Plugin\Db\StatementRecorder"/>
    </type>
    <type name="Magento\Search\Model\Query">
        <plugin name="graphcommerce_catalog_storefront_search_term_recording" type="GraphCommerce\CatalogStorefront\Plugin\Search\SearchTermRecording"/>
    </type>
</config>
