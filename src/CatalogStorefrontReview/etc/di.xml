<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The reviews feed is delivered like the catalog feeds: during indexing, keyed like the modern feed tables. -->
    <virtualType name="Magento\ProductReviewDataExporter\Model\Indexer\ProductReviewsFeedIndexMetadata"
                 type="Magento\DataExporter\Model\Indexer\FeedIndexMetadata">
        <arguments>
            <argument name="feedTableField" xsi:type="string">source_entity_id</argument>
            <argument name="feedTableMutableColumns" xsi:type="array">
                <item name="feed_data" xsi:type="string">feed_data</item>
                <item name="is_deleted" xsi:type="string">is_deleted</item>
            </argument>
            <argument name="exportImmediately" xsi:type="boolean">true</argument>
            <argument name="persistExportedFeed" xsi:type="init_parameter">Magento\DataExporter\Model\ExportFeedInterface::PERSIST_EXPORTED_FEED</argument>
            <argument name="minimalPayload" xsi:type="array">
                <item name="reviewId" xsi:type="string">reviewId</item>
                <item name="productId" xsi:type="string">productId</item>
            </argument>
            <argument name="feedItemIdentifiers" xsi:type="array">
                <item name="reviewId" xsi:type="string">reviewId</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\ProductReviewDataExporter\Model\Indexer\RatingFeedIndexMetadata"
                 type="Magento\DataExporter\Model\Indexer\FeedIndexMetadata">
        <arguments>
            <argument name="feedTableField" xsi:type="string">source_entity_id</argument>
            <argument name="feedTableMutableColumns" xsi:type="array">
                <item name="feed_data" xsi:type="string">feed_data</item>
                <item name="is_deleted" xsi:type="string">is_deleted</item>
            </argument>
            <argument name="exportImmediately" xsi:type="boolean">true</argument>
            <argument name="persistExportedFeed" xsi:type="init_parameter">Magento\DataExporter\Model\ExportFeedInterface::PERSIST_EXPORTED_FEED</argument>
            <argument name="minimalPayload" xsi:type="array">
                <item name="ratingId" xsi:type="string">ratingId</item>
                <item name="storeViewCode" xsi:type="string">storeViewCode</item>
            </argument>
            <argument name="feedItemIdentifiers" xsi:type="array">
                <item name="ratingId" xsi:type="string">ratingId</item>
                <item name="storeViewCode" xsi:type="string">storeViewCode</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- The legacy rating serializer reads the plain row; immediate export hands over the generic shape. -->
    <virtualType name="Magento\ProductReviewDataExporter\Model\Indexer\RatingFeedIndexer"
                 type="Magento\DataExporter\Model\Indexer\FeedIndexer">
        <arguments>
            <argument name="serializer" xsi:type="object">Magento\DataExporter\Model\Indexer\DataSerializer</argument>
        </arguments>
    </virtualType>

    <type name="GraphCommerce\CatalogStorefront\Model\Document\Delivery">
        <arguments>
            <argument name="writers" xsi:type="array">
                <item name="reviews" xsi:type="object">GraphCommerce\CatalogStorefrontReview\Model\Document\Writer\Reviews</item>
                <item name="ratingMetadata" xsi:type="object">GraphCommerce\CatalogStorefrontReview\Model\Document\Writer\Ratings</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\ReviewGraphQl\Model\Resolver\Product\Reviews">
        <plugin name="graphcommerce_catalog_storefront_reviews"
                type="GraphCommerce\CatalogStorefrontReview\Plugin\Resolver\ReviewsFromDocument"/>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Model\Read\DocumentHydration">
        <arguments>
            <argument name="prefillers" xsi:type="array">
                <item name="reviews" xsi:type="object">GraphCommerce\CatalogStorefrontReview\Model\Read\Prefill\Reviews</item>
            </argument>
            <argument name="fieldDocumentKeys" xsi:type="array">
                <item name="reviews" xsi:type="array"><item name="0" xsi:type="string">reviews</item></item>
                <item name="rating_summary" xsi:type="array"><item name="0" xsi:type="string">reviews</item></item>
                <item name="review_count" xsi:type="array"><item name="0" xsi:type="string">reviews</item></item>
            </argument>
            <argument name="baseFields" xsi:type="array">
                <item name="rating_summary" xsi:type="string">rating_summary</item>
                <item name="review_count" xsi:type="string">review_count</item>
            </argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Plugin\GraphQl\ReuseSchema">
        <arguments>
            <argument name="prefilledFields" xsi:type="array">
                <item name="ProductInterface" xsi:type="array">
                    <item name="rating_summary" xsi:type="string">rating_summary</item>
                    <item name="review_count" xsi:type="string">review_count</item>
                </item>
                <item name="ProductReview" xsi:type="array">
                    <item name="average_rating" xsi:type="string">average_rating</item>
                    <item name="ratings_breakdown" xsi:type="string">ratings_breakdown</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
