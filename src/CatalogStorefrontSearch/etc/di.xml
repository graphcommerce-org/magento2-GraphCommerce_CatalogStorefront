<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The listing's entity id tie-break sorts on a field of the fulltext document instead of a script over every match. -->
    <type name="Magento\Elasticsearch\Model\Adapter\BatchDataMapper\ProductDataMapper">
        <plugin name="graphcommerce_catalog_storefront_entity_id_field" type="GraphCommerce\CatalogStorefrontSearch\Plugin\EntityIdField"/>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\Query\Builder\Sort\EntityId">
        <plugin name="graphcommerce_catalog_storefront_entity_id_sort" type="GraphCommerce\CatalogStorefrontSearch\Plugin\EntityIdSort"/>
    </type>
    <type name="Magento\Elasticsearch\Model\Adapter\FieldMapper\FieldMapperResolver">
        <plugin name="graphcommerce_catalog_storefront_field_name_memo" type="GraphCommerce\CatalogStorefrontSearch\Plugin\FieldNameMemo"/>
    </type>
    <type name="Magento\Elasticsearch\Model\Adapter\Index\Builder">
        <plugin name="graphcommerce_catalog_storefront_result_window_setting" type="GraphCommerce\CatalogStorefrontSearch\Plugin\ResultWindowSetting"/>
    </type>
    <type name="Magento\Search\Model\Search\PageSizeProvider">
        <plugin name="graphcommerce_catalog_storefront_result_window_page_size" type="GraphCommerce\CatalogStorefrontSearch\Plugin\ResultWindowPageSize"/>
    </type>
    <type name="Magento\Search\Model\Query">
        <plugin name="graphcommerce_catalog_storefront_search_term_recording" type="GraphCommerce\CatalogStorefrontSearch\Plugin\SearchTermRecording"/>
    </type>
    <!-- The `auto` price navigation step comes from the search response; the price queries read aggregations only. -->
    <type name="Magento\Elasticsearch\SearchAdapter\Aggregation\Builder\Dynamic">
        <plugin name="graphcommerce_catalog_storefront_auto_price_range" type="GraphCommerce\CatalogStorefrontSearch\Plugin\AutoPriceRangeFromResponse"/>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\QueryContainer">
        <plugin name="graphcommerce_catalog_storefront_lean_price_query" type="GraphCommerce\CatalogStorefrontSearch\Plugin\LeanPriceQuery"/>
    </type>
</config>
