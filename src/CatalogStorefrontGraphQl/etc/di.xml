<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="GraphCommerce\CatalogStorefrontGraphQlApi\Read\HydrationInterface" type="GraphCommerce\CatalogStorefrontGraphQl\Model\DocumentHydration"/>

    <!-- One bearer token read per request; the JWT reader first, so the storefront's token skips the opaque token lookup. -->
    <type name="Magento\Integration\Model\CompositeTokenReader">
        <plugin name="graphcommerce_catalog_storefront_user_token_memo" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\UserTokenMemo"/>
        <arguments>
            <argument name="readers" xsi:type="array">
                <item name="5" xsi:type="object">Magento\JwtUserToken\Model\Reader</item>
                <item name="10" xsi:type="object">Magento\Integration\Model\OpaqueToken\Reader</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Integration\Model\CompositeUserTokenValidator">
        <plugin name="graphcommerce_catalog_storefront_user_token_validate_memo" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\UserTokenValidateMemo"/>
    </type>
    <!-- A customer JWT carries the group and the website; the request context reads them from the token. -->
    <type name="Magento\Customer\Model\ResourceModel\Customer">
        <plugin name="graphcommerce_catalog_storefront_revoke_on_group_change" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Token\RevokeOnGroupChange"/>
    </type>
    <type name="Magento\JwtUserToken\Model\Issuer">
        <plugin name="graphcommerce_catalog_storefront_customer_claims_into_token" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Token\CustomerClaimsIntoToken"/>
    </type>
    <type name="Magento\CustomerGraphQl\Model\Context\AddUserInfoToContext">
        <plugin name="graphcommerce_catalog_storefront_customer_context_from_token" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\CustomerContextFromToken"/>
    </type>
    <type name="Magento\CustomerGraphQl\Model\Context\AddCustomerGroupToContext">
        <plugin name="graphcommerce_catalog_storefront_customer_group_from_token" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\CustomerGroupFromToken"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\ProductSearch">
        <plugin name="graphcommerce_catalog_storefront_serve_search" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\DataProvider\ServeSearchFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\Product">
        <plugin name="graphcommerce_catalog_storefront_serve_filter" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\DataProvider\ServeFilterFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\MediaGallery">
        <plugin name="graphcommerce_catalog_storefront_media_gallery" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\MediaGalleryFromDocument"/>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\Resolver\UrlRewrite">
        <plugin name="graphcommerce_catalog_storefront_url_rewrites" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\UrlRewritesFromDocument"/>
    </type>
    <type name="Magento\RelatedProductGraphQl\Model\Resolver\Batch\AbstractLikedProducts">
        <plugin name="graphcommerce_catalog_storefront_linked_products" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\LinkedProductsFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Categories">
        <plugin name="graphcommerce_catalog_storefront_categories" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\CategoriesFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\CategoriesQuery">
        <plugin name="graphcommerce_catalog_storefront_category_list" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\CategoryListFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\CategoryList">
        <plugin name="graphcommerce_catalog_storefront_category_list" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\CategoryListFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\ProductCustomAttributes">
        <plugin name="graphcommerce_catalog_storefront_custom_attributes" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\CustomAttributesFromDocument"/>
    </type>
    <type name="Magento\EavGraphQl\Model\TypeResolver\AttributeValue">
        <plugin name="graphcommerce_catalog_storefront_attribute_value_type" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Resolver\AttributeValueTypeFromDocument"/>
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\LayeredNavigation\AttributeOptionProvider">
        <plugin name="graphcommerce_catalog_storefront_attribute_options" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Layer\AttributeOptionsFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\LayeredNavigation\Builder\Category">
        <plugin name="graphcommerce_catalog_storefront_category_facet" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Layer\CategoryFacetFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\LayeredNavigation\Builder\Aggregations\Category\IncludeDirectChildrenOnly">
        <plugin name="graphcommerce_catalog_storefront_category_facet" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Layer\CategoryFacetFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\LayeredNavigation\RootCategoryProvider">
        <plugin name="graphcommerce_catalog_storefront_root_category" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Layer\RootCategoryFromStore"/>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="catalog_storefront_parity" xsi:type="object">GraphCommerce\CatalogStorefrontGraphQl\Console\Command\Parity</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\GraphQl\Query\QueryProcessor">
        <plugin name="graphcommerce_catalog_storefront_strict_report" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Query\StrictReport"/>
    </type>
    <type name="Magento\Framework\GraphQl\Schema\SchemaGeneratorInterface">
        <plugin name="graphcommerce_catalog_storefront_route_prefilled_fields" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Query\RoutePrefilledFields" sortOrder="20"/>
    </type>

    <!-- Fields the executor reads from the pre-filled value instead of calling the core resolver. -->
    <type name="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Query\RoutePrefilledFields">
        <arguments>
            <argument name="prefilledFields" xsi:type="array">
                <item name="ProductInterface" xsi:type="array">
                    <item name="uid" xsi:type="string">uid</item>
                    <item name="id" xsi:type="string">id</item>
                    <item name="new_from_date" xsi:type="string">new_from_date</item>
                    <item name="new_to_date" xsi:type="string">new_to_date</item>
                    <item name="image" xsi:type="string">image</item>
                    <item name="small_image" xsi:type="string">small_image</item>
                    <item name="thumbnail" xsi:type="string">thumbnail</item>
                    <item name="websites" xsi:type="string">websites</item>
                    <item name="media_gallery_entries" xsi:type="string">media_gallery_entries</item>
                </item>
                <item name="CategoryInterface" xsi:type="array">
                    <item name="product_count" xsi:type="string">product_count</item>
                    <item name="breadcrumbs" xsi:type="string">breadcrumbs</item>
                </item>
                <item name="ProductImage" xsi:type="array">
                    <item name="url" xsi:type="string">url</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefrontGraphQl\Model\DocumentHydration">
        <arguments>
            <argument name="prefillers" xsi:type="array">
                <item name="productFields" xsi:type="object">GraphCommerce\CatalogStorefrontGraphQl\Model\Prefill\ProductFields</item>
                <item name="customAttributeDocuments" xsi:type="object">GraphCommerce\CatalogStorefrontGraphQl\Model\Prefill\CustomAttributeDocuments</item>
            </argument>
        </arguments>
    </type>
</config>
