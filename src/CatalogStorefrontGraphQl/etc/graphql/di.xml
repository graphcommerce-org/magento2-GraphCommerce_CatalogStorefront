<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\GraphQlCache\Model\CacheId\CacheIdCalculator">
        <arguments>
            <argument name="idFactorProviders" xsi:type="array">
                <item name="catalog_storefront" xsi:type="object">GraphCommerce\CatalogStorefrontGraphQl\Model\Cache\ModeFactor</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\GraphQlResolverCache\Model\Resolver\Result\CacheKey\Calculator\Provider">
        <arguments>
            <argument name="factorProviders" xsi:type="array">
                <item name="Magento\CatalogGraphQl\Model\Resolver\Product\MediaGallery" xsi:type="array">
                    <item name="catalog_storefront" xsi:type="string">GraphCommerce\CatalogStorefrontGraphQl\Model\Cache\ModeFactor</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- The tax address of a signed-in customer is a join read of three columns, the tax class follows the session's group. -->
    <type name="Magento\Tax\Model\Calculation">
        <plugin name="graphcommerce_catalog_storefront_customer_address_columns" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Tax\CustomerAddressColumns"/>
    </type>
    <!-- The session cleanup after dispatch reads the customer from the token's claims, not from two customer loads. -->
    <type name="Magento\GraphQl\Controller\GraphQl">
        <plugin name="ClearCustomerSessionAfterRequest" disabled="true"/>
        <plugin name="graphcommerce_catalog_storefront_customer_session_after_dispatch" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\CustomerSessionAfterDispatch" sortOrder="1"/>
    </type>
    <type name="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\CustomerSessionAfterDispatch">
        <arguments>
            <argument name="session" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Customer\Model\Session">
        <plugin name="graphcommerce_catalog_storefront_customer_id_check_from_token" type="GraphCommerce\CatalogStorefrontGraphQl\Plugin\Request\CustomerIdCheckFromToken"/>
    </type>
</config>
