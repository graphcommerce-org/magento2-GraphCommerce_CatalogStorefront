<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Detail\ProductDocument">
        <arguments>
            <argument name="supportedOptionTypes" xsi:type="array"/>
        </arguments>
    </type>
    <!-- Marks the listing collection of every layer: the core, the Elasticsearch and the ElasticSuite providers each implement this interface. -->
    <type name="Magento\Catalog\Model\Layer\ItemCollectionProviderInterface">
        <plugin name="graphcommerce_catalog_storefront_product_listing_collection_flag"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\CollectionFlag"/>
    </type>

    <!-- Marks a related, upsell or crosssell row. A grouped product's children are not marked. -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Link\Product\Collection">
        <plugin name="graphcommerce_catalog_storefront_product_link_collection_flag"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\LinkCollectionFlag"/>
    </type>

    <!-- Acts only on a marked collection, so nested collections are out of reach. -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="graphcommerce_catalog_storefront_product_listing_hydration"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\ListingHydration"/>
    </type>

    <!--
        Acts only on the product the request renders, so the cart, the wishlist, an order and the
        admin share the repository without sharing this. The document goes on at the first load,
        because the page reads the product straight away and a type instance memoises what it built.
    -->
    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="graphcommerce_catalog_storefront_product_detail_document"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Detail\ProductDocument"/>
    </type>

    <!-- The price box of a document product renders without the block cache. -->
    <type name="Magento\Framework\Pricing\Render\RendererPool">
        <plugin name="graphcommerce_catalog_storefront_product_price_box_uncached"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\PriceBoxUncached"/>
    </type>

    <!-- The special price map of a document listing comes from the documents and the child price ranges. -->
    <type name="Magento\Catalog\Pricing\Price\SpecialPriceBulkResolverInterface">
        <plugin name="graphcommerce_catalog_storefront_product_special_price_map"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\SpecialPriceMapFromDocuments"/>
    </type>

    <!-- The product URL rewrites of a document listing come from the documents. -->
    <type name="Magento\UrlRewrite\Model\UrlFinderInterface">
        <plugin name="graphcommerce_catalog_storefront_product_url_rewrites"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\UrlRewritesFromDocuments" sortOrder="-100"/>
    </type>

    <!-- The filterable attributes of the layered navigation come from the attribute documents. -->
    <type name="Magento\Catalog\Model\Layer\FilterableAttributeListInterface">
        <plugin name="graphcommerce_catalog_storefront_filterable_attributes"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\FilterableAttributesFromDocuments"/>
    </type>

    <!-- The tax of a document product's amount from the request's rate, as the GraphQL path prices it. -->
    <type name="Magento\Catalog\Helper\Data">
        <plugin name="graphcommerce_catalog_storefront_product_tax_price"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\TaxPriceFromRate"/>
    </type>

    <!-- The URL of a document product is its base URL and request path. -->
    <type name="Magento\Catalog\Model\Product\Url">
        <plugin name="graphcommerce_catalog_storefront_product_url"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Listing\ProductUrlFromRequestPath"/>
    </type>

    <type name="Magento\PageCache\Model\Config">
        <plugin name="graphcommerce_catalog_storefront_keyed_page_uncacheable"
                type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\KeyedPageUncacheable"/>
    </type>

    <!--
        The gate's per-render patterns, for a theme whose markup carries its own. Declared even
        though it is empty: a constructor array the compiled factory cannot resolve is passed as
        null, and every CLI command then fails at Application::init() because the console builds
        every command before it runs one.
    -->
    <type name="GraphCommerce\CatalogStorefrontProductFrontend\Console\Command\ParityListing">
        <arguments>
            <argument name="perRender" xsi:type="array"/>
        </arguments>
    </type>

    <type name="GraphCommerce\CatalogStorefrontProductFrontend\Console\Command\ParityDetail">
        <arguments>
            <argument name="perRender" xsi:type="array"/>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="catalog_storefront_parity_listing" xsi:type="object">GraphCommerce\CatalogStorefrontProductFrontend\Console\Command\ParityListing</item>
                <item name="catalog_storefront_parity_detail" xsi:type="object">GraphCommerce\CatalogStorefrontProductFrontend\Console\Command\ParityDetail</item>
            </argument>
        </arguments>
    </type>
</config>
