<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="Product">
        <field name="skuType" type="String" provider="GraphCommerce\CatalogStorefrontBundleProduct\Model\DataExporter\Provider\BundleAttributes">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
        <field name="shipmentType" type="String" provider="GraphCommerce\CatalogStorefrontBundleProduct\Model\DataExporter\Provider\BundleAttributes">
            <using field="productId"/>
            <using field="storeViewCode"/>
        </field>
    </record>
</config>
