<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Marks the listing collection. ElasticSuite's category layer is a virtualType of this class. -->
    <type name="Magento\Catalog\Model\Layer\Search\ItemCollectionProvider">
        <plugin name="graphcommerce_catalog_storefront_product_listing_collection_flag"
                type="GraphCommerce\CatalogStorefrontProductListing\Plugin\Listing\CollectionFlag"/>
    </type>

    <!-- Acts only on a marked collection, so nested collections are out of reach. -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="graphcommerce_catalog_storefront_product_listing_hydration"
                type="GraphCommerce\CatalogStorefrontProductListing\Plugin\Listing\ListingHydration"/>
    </type>

    <!-- A request that names its own path must not land in the ordinary page's cache slot. -->
    <type name="Magento\Framework\App\PageCache\Identifier">
        <plugin name="graphcommerce_catalog_storefront_product_listing_page_cache_identifier"
                type="GraphCommerce\CatalogStorefrontProductListing\Plugin\PageCacheIdentifier"/>
    </type>

    <!--
        The gate's per-render patterns, for a theme whose markup carries its own. Declared even
        though it is empty: a constructor array the compiled factory cannot resolve is passed as
        null, and every CLI command then fails at Application::init() because the console builds
        every command before it runs one.
    -->
    <type name="GraphCommerce\CatalogStorefrontProductListing\Console\Command\ParityListing">
        <arguments>
            <argument name="perRender" xsi:type="array"/>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="catalog_storefront_parity_listing" xsi:type="object">GraphCommerce\CatalogStorefrontProductListing\Console\Command\ParityListing</item>
            </argument>
        </arguments>
    </type>
</config>
