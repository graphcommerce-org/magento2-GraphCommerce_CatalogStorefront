<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">catalog_storefront_views_listing.catalog_storefront_views_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>catalog_storefront_views_listing_columns</spinner>
        <deps>
            <dep>catalog_storefront_views_listing.catalog_storefront_views_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="catalog_storefront_views_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
        </settings>
        <aclResource>GraphCommerce_CatalogStorefrontAdminhtml::views</aclResource>
        <dataProvider class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\DataProvider\RegistryListing" name="catalog_storefront_views_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <columns class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\Component\RegistryColumns" name="catalog_storefront_views_listing_columns" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="heading" xsi:type="string" translate="true">Catalog Views</item>
                <item name="actionLabel" xsi:type="string" translate="true">Create Catalog View</item>
                <item name="infoText" xsi:type="string" translate="true">Stored views and their resource relationships.</item>
                <item name="dataset" xsi:type="string">catalogViews</item>
                <item name="dndConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="editorConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="resizeConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
            </item>
        </argument>
        <column name="name" sortOrder="10">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/view</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">View</label>
            </settings>
        </column>
        <column name="status" sortOrder="15">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/status</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="protection" sortOrder="20">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/badge</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Protection</label>
            </settings>
        </column>
        <column name="source" sortOrder="30">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Catalog Source</label>
            </settings>
        </column>
        <column name="stock" sortOrder="35">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Stock</label>
            </settings>
        </column>
        <column name="bookMode" sortOrder="40">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/books</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Price Books</label>
            </settings>
        </column>
        <column name="policies" sortOrder="50">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Policies</label>
            </settings>
        </column>
        <column name="layers" sortOrder="60">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Layers</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\Component\ResourceActions" sortOrder="100">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="resourceKind" xsi:type="string">views</item></item></argument>
            <settings><indexField>id</indexField><label translate="true">Actions</label></settings>
        </actionsColumn>
    </columns>
</listing>
