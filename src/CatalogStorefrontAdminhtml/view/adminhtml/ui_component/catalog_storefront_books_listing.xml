<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">catalog_storefront_books_listing.catalog_storefront_books_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>catalog_storefront_books_listing_columns</spinner>
        <deps>
            <dep>catalog_storefront_books_listing.catalog_storefront_books_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="catalog_storefront_books_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
        </settings>
        <aclResource>GraphCommerce_CatalogStorefrontAdminhtml::views</aclResource>
        <dataProvider class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\DataProvider\OverviewDataProvider" name="catalog_storefront_books_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <columns name="catalog_storefront_books_listing_columns" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="heading" xsi:type="string" translate="true">Price Books</item>
                <item name="actionLabel" xsi:type="string" translate="true">Add Price Book</item>
                <item name="infoText" xsi:type="string" translate="true">Magento customer groups provide the current price contexts. Independent price-book records are not available.</item>
                <item name="dataset" xsi:type="string">books</item>
                <item name="dndConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="editorConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="resizeConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
            </item>
        </argument>
        <column name="id" sortOrder="10">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/price-book</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Price Book</label>
            </settings>
        </column>
        <column name="type" sortOrder="20">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="name" sortOrder="30">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Origin</label>
            </settings>
        </column>
        <column name="role" sortOrder="40">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Role</label>
            </settings>
        </column>
        <column name="currency" sortOrder="50">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/currency</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Currency</label>
            </settings>
        </column>
        <column name="feedPrices" sortOrder="60">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/feed</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Product Prices</label>
                <headerTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/columns/number</headerTmpl>
                <fieldClass>
                    <class name="catalog-overview-number">true</class>
                    <class name="catalog-overview-feed-column">true</class>
                </fieldClass>
            </settings>
        </column>
        <column name="actions" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/columns/more" sortOrder="70">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/more</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Actions</label>
                <visible>true</visible>
            </settings>
        </column>
    </columns>
</listing>
