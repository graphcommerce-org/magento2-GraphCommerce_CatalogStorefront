<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">catalog_storefront_policies_listing.catalog_storefront_policies_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>catalog_storefront_policies_listing_columns</spinner>
        <deps>
            <dep>catalog_storefront_policies_listing.catalog_storefront_policies_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="catalog_storefront_policies_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">name</param>
            </storageConfig>
        </settings>
        <aclResource>GraphCommerce_CatalogStorefrontAdminhtml::views</aclResource>
        <dataProvider class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\DataProvider\RegistryListing" name="catalog_storefront_policies_listing_data_source">
            <settings>
                <requestFieldName>name</requestFieldName>
                <primaryFieldName>name</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <columns class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\Component\RegistryColumns" name="catalog_storefront_policies_listing_columns" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="heading" xsi:type="string" translate="true">Catalog Policies</item>
                <item name="actionLabel" xsi:type="string" translate="true">Add Policy</item>
                <item name="infoText" xsi:type="string" translate="true">Stored policies and their resource relationships.</item>
                <item name="dataset" xsi:type="string">policies</item>
                <item name="dndConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="editorConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
                <item name="resizeConfig" xsi:type="array">
                    <item name="enabled" xsi:type="boolean">false</item>
                </item>
            </item>
        </argument>
        <column name="name" sortOrder="10">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/source</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Policy</label>
            </settings>
        </column>
        <column name="filter" sortOrder="20">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Filter</label>
            </settings>
        </column>
        <column name="valueSource" sortOrder="30">
            <settings>
                <bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/badge</bodyTmpl>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Value Source</label>
            </settings>
        </column>
        <column name="trigger" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/columns/info" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="infoText" xsi:type="string" translate="true">Stored policies and their resource relationships.</item>
                </item>
            </argument>
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Trigger</label>
            </settings>
        </column>
        <column name="linkedViews" sortOrder="50">
            <settings>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <label translate="true">Linked Views</label>
                <headerTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/columns/number</headerTmpl>
                <fieldClass>
                    <class name="catalog-overview-number">true</class>
                </fieldClass>
            </settings>
        </column>
        <actionsColumn name="actions" class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\Component\ResourceActions" sortOrder="100">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="resourceKind" xsi:type="string">policies</item></item></argument>
            <settings><indexField>id</indexField><label translate="true">Actions</label></settings>
        </actionsColumn>
    </columns>
</listing>
