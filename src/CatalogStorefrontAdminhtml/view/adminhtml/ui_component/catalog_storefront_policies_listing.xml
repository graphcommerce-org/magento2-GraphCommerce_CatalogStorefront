<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array"><item name="js_config" xsi:type="array"><item name="provider" xsi:type="string">catalog_storefront_policies_listing.catalog_storefront_policies_listing_data_source</item></item></argument>
    <settings><spinner>catalog_storefront_policies_listing_columns</spinner><deps><dep>catalog_storefront_policies_listing.catalog_storefront_policies_listing_data_source</dep></deps></settings>
    <dataSource name="catalog_storefront_policies_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings><updateUrl path="mui/index/render"/><storageConfig><param name="indexField" xsi:type="string">name</param></storageConfig></settings>
        <aclResource>GraphCommerce_CatalogStorefrontAdminhtml::views</aclResource>
        <dataProvider class="GraphCommerce\CatalogStorefrontAdminhtml\Ui\DataProvider\OverviewDataProvider" name="catalog_storefront_policies_listing_data_source">
            <settings><requestFieldName>name</requestFieldName><primaryFieldName>name</primaryFieldName></settings>
        </dataProvider>
    </dataSource>
    <columns name="catalog_storefront_policies_listing_columns" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/listing">
        <argument name="data" xsi:type="array"><item name="config" xsi:type="array">
                <item name="heading" xsi:type="string" translate="true">Catalog Policies</item>
                <item name="actionLabel" xsi:type="string" translate="true">Add Policy</item>
                <item name="infoText" xsi:type="string" translate="true">Magento assortment rules are derived per active store view. Editable policies and triggers are not available.</item>
                <item name="dataset" xsi:type="string">policies</item>
                <item name="dndConfig" xsi:type="array"><item name="enabled" xsi:type="boolean">false</item></item>
                <item name="editorConfig" xsi:type="array"><item name="enabled" xsi:type="boolean">false</item></item>
                <item name="resizeConfig" xsi:type="array"><item name="enabled" xsi:type="boolean">false</item></item>
        </item></argument>
        <column name="name" sortOrder="10">
            <settings><bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/source</bodyTmpl><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Policy</label></settings>
        </column>
        <column name="filter" sortOrder="20">
            <settings><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Filter</label></settings>
        </column>
        <column name="type" sortOrder="30">
            <settings><bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/badge</bodyTmpl><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Value Source</label></settings>
        </column>
        <column name="trigger" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/columns/info" sortOrder="40">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="infoText" xsi:type="string" translate="true">Policy triggers are not available until managed catalog policies are supported.</item></item></argument>
            <settings><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Trigger</label></settings>
        </column>
        <column name="views" sortOrder="50">
            <settings><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Linked Views</label><headerTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/columns/number</headerTmpl><fieldClass><class name="catalog-overview-number">true</class></fieldClass></settings>
        </column>
        <column name="actions" component="GraphCommerce_CatalogStorefrontAdminhtml/js/grid/columns/more" sortOrder="60">
            <settings><bodyTmpl>GraphCommerce_CatalogStorefrontAdminhtml/grid/cells/more</bodyTmpl><sortable>false</sortable><draggable>false</draggable><controlVisibility>false</controlVisibility><label translate="true">Actions</label><visible>true</visible></settings>
        </column>
    </columns>
</listing>
