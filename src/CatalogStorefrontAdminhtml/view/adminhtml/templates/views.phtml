<?php
/**
 * @var \GraphCommerce\CatalogStorefrontAdminhtml\Block\Adminhtml\Views $block
 * @var \Magento\Framework\Escaper $escaper
 */
$views = $block->views();
$groups = $block->groups();
$contributions = $block->contributions();
$dash = __('—');
$currencies = [];
foreach ($views as $view) {
    if ($view['currency']['base'] !== '') {
        $currencies[$view['currency']['base']] = true;
    }
}
$currencyLabel = $currencies === [] ? $dash : implode(', ', array_keys($currencies));
$groupCount = $groups['available'] ? count($groups['items']) : 0;
$priceBookCount = 1 + $groupCount;
$action = static function (string $label, string $id) use ($escaper): void {
    ?>
    <span class="catalog-storefront-action-wrap">
        <button class="catalog-storefront-action" type="button"
                popovertarget="<?= $escaper->escapeHtmlAttr($id) ?>">
            <?= $escaper->escapeHtml(__($label)) ?>
        </button>
        <div class="catalog-storefront-popover" role="dialog" popover id="<?= $escaper->escapeHtmlAttr($id) ?>">
            <?= $escaper->escapeHtml(__('This management workflow is not available yet.')) ?>
        </div>
    </span>
    <?php
};
$info = static function (string $text, string $id) use ($escaper): void {
    ?>
    <span class="catalog-storefront-info-wrap">
        <button class="catalog-storefront-info" type="button"
                aria-label="<?= $escaper->escapeHtmlAttr(__('More information')) ?>"
                popovertarget="<?= $escaper->escapeHtmlAttr($id) ?>">i</button>
        <span class="catalog-storefront-popover" role="tooltip" popover id="<?= $escaper->escapeHtmlAttr($id) ?>">
            <?= $escaper->escapeHtml(__($text)) ?>
        </span>
    </span>
    <?php
};
$details = static function (string $label, string $id, ?string $description = null) use ($escaper): void {
    ?>
    <button class="catalog-storefront-row-menu" type="button"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Details for %1', $label)) ?>"
            popovertarget="<?= $escaper->escapeHtmlAttr($id) ?>">…</button>
    <span class="catalog-storefront-popover" role="dialog" popover id="<?= $escaper->escapeHtmlAttr($id) ?>">
        <?= $escaper->escapeHtml($description ?? __('Detailed management is not available yet.')) ?>
    </span>
    <?php
};
