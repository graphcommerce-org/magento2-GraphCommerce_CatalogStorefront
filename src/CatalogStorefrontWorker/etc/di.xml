<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The built objects a persistent worker keeps between requests, each under the config generation. The data entries are FastBoot features. -->
    <type name="Magento\Framework\GraphQl\Schema\SchemaGeneratorInterface">
        <plugin name="graphcommerce_catalog_storefront_reuse_schema" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Query\ReuseSchema" sortOrder="10"/>
    </type>
    <type name="Magento\Framework\GraphQl\Query\QueryProcessor">
        <plugin name="graphcommerce_catalog_storefront_validate_once" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Query\ValidateOncePerProcess" sortOrder="20"/>
    </type>
    <type name="Magento\Framework\GraphQl\Query\QueryParser">
        <plugin name="graphcommerce_catalog_storefront_keep_parsed_documents" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Query\KeepParsedDocuments"/>
    </type>
    <type name="Magento\Store\Model\Store">
        <plugin name="graphcommerce_catalog_storefront_reset_current_currency" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Store\ResetCurrentCurrency"/>
    </type>
    <type name="Magento\Theme\Model\Theme\ThemeProvider">
        <plugin name="graphcommerce_catalog_storefront_theme_by_path_memo" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Theme\ThemeByPathMemo"/>
    </type>

    <!-- Refresh changed config before request state, sessions and store context initialize. After the current headers are registered, clear any path and report decisions made during application construction or the reload. The proxies break the request and reload plugin cycles. -->
    <type name="GraphCommerce\CatalogStorefrontWorker\Plugin\State\ReloadPerGeneration">
        <arguments>
            <argument name="reloadProcessor" xsi:type="object">Magento\Framework\App\State\ReloadProcessorInterface\Proxy</argument>
            <argument name="requestDecisions" xsi:type="object">GraphCommerce\CatalogStorefrontWorker\Model\State\RequestDecisions\Proxy</argument>
        </arguments>
    </type>
    <type name="Opengento\Application\App\Request\RequestRegistry">
        <plugin name="graphcommerce_catalog_storefront_reload_before_request" type="GraphCommerce\CatalogStorefrontWorker\Plugin\State\ReloadPerGeneration" sortOrder="10"/>
    </type>

    <!-- The reload after a response runs once per config generation; between generations only the request's own processor runs. -->
    <type name="Magento\Framework\App\State\ReloadProcessorComposite">
        <plugin name="graphcommerce_catalog_storefront_reload_per_generation" type="GraphCommerce\CatalogStorefrontWorker\Plugin\State\ReloadPerGeneration" sortOrder="20"/>
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="Opengento_Application::reload" xsi:type="object">GraphCommerce\CatalogStorefrontWorker\Model\State\RequestReload</item>
            </argument>
        </arguments>
    </type>
    <preference for="Magento\Framework\Search\Request\Config" type="GraphCommerce\CatalogStorefrontWorker\Model\State\SearchRequestConfig"/>

    <!-- The saves that lift a generation. -->
    <type name="Magento\Framework\Search\Request\Config">
        <plugin name="graphcommerce_catalog_storefront_bump_config" type="GraphCommerce\CatalogStorefrontWorker\Plugin\BumpConfig"/>
    </type>
    <virtualType name="GraphCommerce\CatalogStorefrontWorker\Plugin\BumpConfig" type="GraphCommerce\CatalogStorefrontWorker\Plugin\Bump">
        <arguments>
            <argument name="name" xsi:type="const">GraphCommerce\CatalogStorefrontWorker\Model\Generation::CONFIG</argument>
        </arguments>
    </virtualType>
</config>
