<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The form template asks for the ratings seven times, and the block loads them every time. -->
    <type name="Magento\Review\Block\Form">
        <plugin name="graphcommerce_catalog_storefront_review_ratings_memo"
                type="GraphCommerce\CatalogStorefrontReviewFrontend\Plugin\RatingsMemo"/>
    </type>
</config>
