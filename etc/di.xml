<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\DataExporter\Model\ExportFeedInterface"
                type="GraphCommerce\CatalogStorefront\Model\LocalExportFeed"/>

    <preference for="GraphCommerce\CatalogStorefront\Model\Storage\Client\CommandInterface"
                type="GraphCommerce\CatalogStorefront\Model\Storage\Client\ElasticsearchCommand"/>
    <preference for="GraphCommerce\CatalogStorefront\Model\Storage\Client\QueryInterface"
                type="GraphCommerce\CatalogStorefront\Model\Storage\Client\ElasticsearchQuery"/>
    <preference for="GraphCommerce\CatalogStorefront\Model\Storage\Client\DataDefinitionInterface"
                type="GraphCommerce\CatalogStorefront\Model\Storage\Client\ElasticsearchDataDefinitionAdapter"/>

    <!--
        Storage\Client\Config reads catalog/search/<engine>_server_hostname and siblings, which is
        the convention Magento's own engines use. An engine that keeps its connection elsewhere
        leaves those empty, and Config's `?: 'localhost'` fallback makes that a silent
        misconfiguration rather than an error.
    -->
    <type name="GraphCommerce\CatalogStorefront\Model\Storage\Client\Config\ConnectionPathPool">
        <arguments>
            <argument name="engines" xsi:type="array">
                <!--
                    Smile ElasticSuite keeps host and port together in `servers` as "host:port",
                    comma separated for multiple nodes, so both name the same path and
                    Config::parseHostname() splits them.
                -->
                <item name="elasticsuite" xsi:type="array">
                    <item name="host" xsi:type="string">smile_elasticsuite_core_base_settings/es_client/servers</item>
                    <item name="port" xsi:type="string">smile_elasticsuite_core_base_settings/es_client/servers</item>
                    <item name="user" xsi:type="string">smile_elasticsuite_core_base_settings/es_client/http_auth_user</item>
                    <item name="password" xsi:type="string">smile_elasticsuite_core_base_settings/es_client/http_auth_pwd</item>
                    <item name="enableAuth" xsi:type="string">smile_elasticsuite_core_base_settings/es_client/enable_http_auth</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!--
        The product listing surface. ListingHydration sits on the base product collection, which
        many other collections extend, so it only acts on the one CollectionFlag has marked.
        ItemCollectionProvider is the concrete class behind ElasticSuite's category virtualType.
    -->
    <!--
        Prices a configurable from its variant documents instead of a UNION query plus a collection
        load per card. Falls through to the core provider, which it wraps, whenever the parent was
        not served from a document.
    -->
    <preference for="Magento\ConfigurableProduct\Pricing\Price\LowestPriceOptionsProviderInterface"
                type="GraphCommerce\CatalogStorefront\Model\Read\DocumentLowestPriceOptionsProvider"/>
    <!-- Proxies: both are constructed on every request, but only touch the session when a
         configurable is actually served from documents. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Read\DocumentLowestPriceOptionsProvider">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="GraphCommerce\CatalogStorefront\Plugin\Listing\UsedProductsFromDocuments">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Catalog\Model\Layer\Search\ItemCollectionProvider">
        <plugin name="graphcommerce_catalog_storefront_listing_flag"
                type="GraphCommerce\CatalogStorefront\Plugin\Listing\CollectionFlag"/>
    </type>
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="graphcommerce_catalog_storefront_listing_hydration"
                type="GraphCommerce\CatalogStorefront\Plugin\Listing\ListingHydration"/>
    </type>

    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\ProductSearch">
        <plugin name="graphcommerce_catalog_storefront_serve_search"
                type="GraphCommerce\CatalogStorefront\Plugin\ServeSearchFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\Product">
        <plugin name="graphcommerce_catalog_storefront_serve_filter"
                type="GraphCommerce\CatalogStorefront\Plugin\ServeFilterFromDocuments"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\MediaGallery">
        <plugin name="graphcommerce_catalog_storefront_media_gallery"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\MediaGalleryFromDocument"/>
    </type>
    <type name="Magento\UrlRewriteGraphQl\Model\Resolver\UrlRewrite">
        <plugin name="graphcommerce_catalog_storefront_url_rewrites"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\UrlRewritesFromDocument"/>
    </type>
    <!-- The reviews feed is delivered like the catalog feeds: during indexing, keyed like the modern feed tables. -->
    <virtualType name="Magento\ProductReviewDataExporter\Model\Indexer\ProductReviewsFeedIndexMetadata"
                 type="Magento\DataExporter\Model\Indexer\FeedIndexMetadata">
        <arguments>
            <argument name="feedTableField" xsi:type="string">source_entity_id</argument>
            <argument name="feedTableMutableColumns" xsi:type="array">
                <item name="feed_data" xsi:type="string">feed_data</item>
                <item name="is_deleted" xsi:type="string">is_deleted</item>
            </argument>
            <argument name="exportImmediately" xsi:type="boolean">true</argument>
            <argument name="persistExportedFeed" xsi:type="init_parameter">Magento\DataExporter\Model\ExportFeedInterface::PERSIST_EXPORTED_FEED</argument>
            <argument name="minimalPayload" xsi:type="array">
                <item name="reviewId" xsi:type="string">reviewId</item>
                <item name="productId" xsi:type="string">productId</item>
            </argument>
            <argument name="feedItemIdentifiers" xsi:type="array">
                <item name="reviewId" xsi:type="string">reviewId</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\CatalogDataExporter\Model\Provider\Product\Links">
        <plugin name="graphcommerce_catalog_storefront_link_position"
                type="GraphCommerce\CatalogStorefront\Plugin\Feed\LinkPosition"/>
    </type>

    <type name="Magento\ConfigurableProductDataExporter\Model\Provider\Product\Options">
        <plugin name="graphcommerce_catalog_storefront_option_value_details"
                type="GraphCommerce\CatalogStorefront\Plugin\Feed\OptionValueDetails"/>
    </type>
    <type name="Magento\ReviewGraphQl\Model\Resolver\Product\RatingSummary">
        <plugin name="graphcommerce_catalog_storefront_rating_summary"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\RatingSummaryFromDocument"/>
    </type>
    <type name="Magento\ReviewGraphQl\Model\Resolver\Product\ReviewCount">
        <plugin name="graphcommerce_catalog_storefront_review_count"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\ReviewCountFromDocument"/>
    </type>

    <type name="Magento\ConfigurableProduct\Model\Product\Type\Configurable">
        <plugin name="graphcommerce_catalog_storefront_salable"
                type="GraphCommerce\CatalogStorefront\Plugin\SalableFromDocument"/>
        <!--
            The two expensive calls a listing page makes per configurable card. Both answer from
            the document and fall through to core when the product was not served from one.
        -->
        <plugin name="graphcommerce_catalog_storefront_used_products"
                type="GraphCommerce\CatalogStorefront\Plugin\Listing\UsedProductsFromDocuments"/>
        <plugin name="graphcommerce_catalog_storefront_configurable_attributes"
                type="GraphCommerce\CatalogStorefront\Plugin\Listing\ConfigurableAttributesFromDocument"/>
    </type>
    <type name="Magento\Bundle\Model\Product\Type">
        <plugin name="graphcommerce_catalog_storefront_salable"
                type="GraphCommerce\CatalogStorefront\Plugin\SalableFromDocument"/>
    </type>
    <type name="Magento\RelatedProductGraphQl\Model\Resolver\Batch\AbstractLikedProducts">
        <plugin name="graphcommerce_catalog_storefront_linked_products"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\LinkedProductsFromDocuments"/>
    </type>
    <type name="Magento\ConfigurableProductGraphQl\Model\Resolver\Options">
        <plugin name="graphcommerce_catalog_storefront_configurable_options"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\ConfigurableOptionsFromDocument"/>
    </type>
    <type name="Magento\SwatchesGraphQl\Model\Resolver\Product\Options\SwatchData">
        <plugin name="graphcommerce_catalog_storefront_swatch_data"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\SwatchDataFromDocument"/>
    </type>
    <type name="Magento\DownloadableGraphQl\Resolver\Product\Links">
        <plugin name="graphcommerce_catalog_storefront_downloadable_links"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\DownloadableLinksFromDocument"/>
    </type>
    <type name="Magento\DownloadableGraphQl\Resolver\Product\Samples">
        <plugin name="graphcommerce_catalog_storefront_downloadable_samples"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\DownloadableSamplesFromDocument"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\MediaGallery\Url">
        <plugin name="graphcommerce_catalog_storefront_image_url_memo"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\ImageUrlMemo"/>
    </type>
    <type name="Magento\CatalogGraphQl\DataProvider\Product\LayeredNavigation\AttributeOptionProvider">
        <plugin name="graphcommerce_catalog_storefront_facet_labels_memo"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\FacetLabelsMemo"/>
    </type>
    <type name="Magento\Elasticsearch\Model\Adapter\FieldMapper\FieldMapperResolver">
        <plugin name="graphcommerce_catalog_storefront_field_name_memo"
                type="GraphCommerce\CatalogStorefront\Plugin\Search\FieldNameMemo"/>
    </type>
    <type name="Magento\Framework\GraphQl\Schema\SchemaGeneratorInterface">
        <plugin name="graphcommerce_catalog_storefront_reuse_schema"
                type="GraphCommerce\CatalogStorefront\Plugin\GraphQl\ReuseSchema"/>
    </type>
    <type name="Magento\Framework\GraphQl\Query\QueryProcessor">
        <plugin name="graphcommerce_catalog_storefront_validate_once"
                type="GraphCommerce\CatalogStorefront\Plugin\GraphQl\ValidateOncePerProcess"/>
    </type>
    <type name="Magento\CatalogGraphQl\Model\Resolver\Product\PriceRange">
        <plugin name="graphcommerce_catalog_storefront_price_range"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\PriceRangeFromDocument"/>
    </type>
    <type name="Magento\CatalogInventoryGraphQl\Model\Resolver\MaxSaleQtyResolver">
        <plugin name="graphcommerce_catalog_storefront_max_sale_qty"
                type="GraphCommerce\CatalogStorefront\Plugin\Resolver\MaxSaleQtyFromConfig"/>
    </type>

    <!-- Document keys a listing fetch leaves out unless the query selects a field that needs them. -->
    <type name="GraphCommerce\CatalogStorefront\Model\Read\DocumentHydration">
        <arguments>
            <argument name="fieldDocumentKeys" xsi:type="array">
                <item name="description" xsi:type="array"><item name="0" xsi:type="string">description</item></item>
                <item name="short_description" xsi:type="array"><item name="0" xsi:type="string">shortDescription</item></item>
                <item name="media_gallery" xsi:type="array"><item name="0" xsi:type="string">media_gallery</item><item name="1" xsi:type="string">images</item><item name="2" xsi:type="string">videos</item></item>
                <item name="media_gallery_entries" xsi:type="array"><item name="0" xsi:type="string">media_gallery</item><item name="1" xsi:type="string">images</item><item name="2" xsi:type="string">videos</item></item>
                <item name="url_rewrites" xsi:type="array"><item name="0" xsi:type="string">urlRewrites</item></item>
                <item name="related_products" xsi:type="array"><item name="0" xsi:type="string">links</item></item>
                <item name="upsell_products" xsi:type="array"><item name="0" xsi:type="string">links</item></item>
                <item name="crosssell_products" xsi:type="array"><item name="0" xsi:type="string">links</item></item>
                <item name="categories" xsi:type="array"><item name="0" xsi:type="string">categoryData</item></item>
                <item name="configurable_options" xsi:type="array"><item name="0" xsi:type="string">configurableOptions</item></item>
                <item name="options" xsi:type="array"><item name="0" xsi:type="string">optionsV2</item><item name="1" xsi:type="string">shopperInputOptions</item></item>
                <item name="downloadable_product_links" xsi:type="array"><item name="0" xsi:type="string">optionsV2</item></item>
                <item name="downloadable_product_samples" xsi:type="array"><item name="0" xsi:type="string">samples</item></item>
                <item name="links_purchased_separately" xsi:type="array"><item name="0" xsi:type="string">optionsV2</item></item>
            </argument>
            <argument name="baseFields" xsi:type="array">
                <item name="__typename" xsi:type="string">__typename</item>
                <item name="uid" xsi:type="string">uid</item>
                <item name="id" xsi:type="string">id</item>
                <item name="sku" xsi:type="string">sku</item>
                <item name="name" xsi:type="string">name</item>
                <item name="url_key" xsi:type="string">url_key</item>
                <item name="url_suffix" xsi:type="string">url_suffix</item>
                <item name="type_id" xsi:type="string">type_id</item>
                <item name="created_at" xsi:type="string">created_at</item>
                <item name="updated_at" xsi:type="string">updated_at</item>
                <item name="image" xsi:type="string">image</item>
                <item name="small_image" xsi:type="string">small_image</item>
                <item name="thumbnail" xsi:type="string">thumbnail</item>
                <item name="price_range" xsi:type="string">price_range</item>
                <item name="stock_status" xsi:type="string">stock_status</item>
                <item name="new_from_date" xsi:type="string">new_from_date</item>
                <item name="new_to_date" xsi:type="string">new_to_date</item>
                <item name="rating_summary" xsi:type="string">rating_summary</item>
                <item name="review_count" xsi:type="string">review_count</item>
                <item name="max_sale_qty" xsi:type="string">max_sale_qty</item>
                <item name="canonical_url" xsi:type="string">canonical_url</item>
                <item name="only_x_left_in_stock" xsi:type="string">only_x_left_in_stock</item>
            </argument>
        </arguments>
    </type>

    <type name="GraphCommerce\CatalogStorefront\Model\Storage\Client\Config\EntityConfigPool">
        <arguments>
            <argument name="configs" xsi:type="array">
                <item name="product" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Storage\Client\Config\Product</item>
                <item name="category" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Storage\Client\Config\Category</item>
                <item name="product_variant" xsi:type="object">GraphCommerce\CatalogStorefront\Model\Storage\Client\Config\ProductVariant</item>
            </argument>
        </arguments>
    </type>
</config>
