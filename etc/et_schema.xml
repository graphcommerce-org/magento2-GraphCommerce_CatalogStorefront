<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="Link">
        <field name="position" type="Int"/>
    </record>
    <record name="ProductOptionValue">
        <field name="defaultLabel" type="String"/>
        <field name="textSwatchValue" type="String"/>
    </record>
    <record name="Export">
        <field name="reviews" type="Review" repeated="true"
               provider="GraphCommerce\CatalogStorefront\Model\Feed\ReviewsDataProcessor">
            <using field="review_id"/>
        </field>
    </record>
</config>
