<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        The reviews exporter ships its feed table in the legacy layout. Immediate export needs the
        columns of the modern layout (as in cde_products_feed), so they are added here. The legacy id
        column becomes auto-increment and product_id gets a default because immediate export fills
        neither, and feed_id stays nullable so the upgrade succeeds on a table that still holds
        legacy rows.
    -->
    <table name="catalog_data_exporter_product_reviews" resource="default" engine="innodb" comment="Product Reviews Feed">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Autoincrement ID"/>
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="true" default="0" comment="Product Id (legacy layout)"/>
        <column xsi:type="int" name="source_entity_id" padding="10" unsigned="true" nullable="false" default="0" comment="Review Id"/>
        <column xsi:type="varchar" name="feed_id" nullable="true" length="64" comment="Feed Item Identifier"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" comment="Feed item status"/>
        <column xsi:type="varchar" name="feed_hash" nullable="false" length="64" default="" comment="Hash of feed_data"/>
        <column xsi:type="text" name="errors" nullable="true" comment="Errors"/>
        <column xsi:type="text" name="metadata" nullable="true" comment="Metadata"/>
        <constraint referenceId="CATALOG_DATA_EXPORTER_PRODUCT_REVIEWS_FEED_ID" xsi:type="unique">
            <column name="feed_id"/>
        </constraint>
        <index referenceId="CATALOG_DATA_EXPORTER_PRODUCT_REVIEWS_SOURCE_ENTITY_ID_MODIFIED_AT" indexType="btree">
            <column name="source_entity_id"/>
            <column name="modified_at"/>
        </index>
        <index referenceId="CATALOG_DATA_EXPORTER_PRODUCT_REVIEWS_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
