// OpenSearch inspection of the document store, in the Dev Tools syntax of
// OpenSearch Dashboards: the VS Code OpenSearch extension runs a request from
// the cursor against the cluster configured in the extension. The store keeps
// one index per entity and store view, named prefix, entity and store view
// code. Replace "default" for another store view. The magento2_* indices are
// core's search indexes, not ours.

// Every index with its document count and size
GET _cat/indices?v&h=index,health,docs.count,store.size&s=index
{}

// Mapping of the product index: only the filtered and aggregated fields are mapped
GET catalog_storefront_product_default/_mapping
{}

// Mapping of the review index: the fields the review module declares
GET catalog_storefront_review_default/_mapping
{}

// One product document by product id
GET catalog_storefront_product_default/_doc/1
{}

// A product document by sku
POST catalog_storefront_product_default/_search
{
  "size": 1,
  "query": { "term": { "sku": "24-WG01" } }
}

// The keys a product document holds, without the large ones
POST catalog_storefront_product_default/_search
{
  "size": 1,
  "query": { "term": { "sku": "24-WG01" } },
  "_source": { "excludes": ["customAttributes", "optionsV2", "attributes", "media_gallery", "urlRewrites", "links", "categoryData"] }
}

// Products by type, to see how the catalog is composed
POST catalog_storefront_product_default/_search
{
  "size": 0,
  "aggs": { "types": { "terms": { "field": "type" } } }
}

// Products with the prices or the stock slice still missing
POST catalog_storefront_product_default/_search
{
  "size": 20,
  "_source": ["sku", "type"],
  "query": {
    "bool": {
      "should": [
        { "bool": { "must_not": { "exists": { "field": "priceIndex" } } } },
        { "bool": { "must_not": { "exists": { "field": "stock" } } } }
      ],
      "minimum_should_match": 1
    }
  }
}

// Salable products only, with their guest price index
POST catalog_storefront_product_default/_search
{
  "size": 10,
  "_source": ["sku", "priceIndex", "stock.isSalable", "stock.qtyForSale"],
  "query": { "term": { "stock.isSalable": true } }
}

// The variants of a configurable, through the parent id list on the children
POST catalog_storefront_product_default/_search
{
  "size": 50,
  "_source": ["sku", "status", "stock.isSalable", "priceIndex"],
  "query": { "term": { "parentIds": "1239" } }
}

// The price range of a configurable for customer group 0, as the listing aggregates it:
// the price index is a nested list with one entry per customer group
POST catalog_storefront_product_default/_search
{
  "size": 0,
  "query": { "bool": { "filter": [ { "term": { "parentIds": "1239" } }, { "term": { "status": "Enabled" } } ] } },
  "aggs": {
    "salable": {
      "filter": { "term": { "stock.isSalable": true } },
      "aggs": {
        "prices": {
          "nested": { "path": "priceIndex" },
          "aggs": {
            "group": {
              "filter": { "term": { "priceIndex.group": "0" } },
              "aggs": {
                "minFinal": { "min": { "field": "priceIndex.final" } },
                "maxFinal": { "max": { "field": "priceIndex.final" } }
              }
            }
          }
        }
      }
    }
  }
}

// Every category document of the store view
POST catalog_storefront_category_default/_search
{
  "size": 100,
  "_source": ["name", "path", "productCount", "isActive", "children"]
}

// One attribute document by code
GET catalog_storefront_attribute_default/_doc/color
{}

// The rating documents: the scales the review percents are computed on
POST catalog_storefront_rating_default/_search
{ "size": 10 }

// The reviews of one product, newest first, as the reviews field pages them
POST catalog_storefront_review_default/_search
{
  "from": 0,
  "size": 5,
  "track_total_hits": true,
  "query": { "term": { "productId": "1239" } },
  "sort": [ { "createdAt": "desc" }, { "reviewId": "asc" } ]
}

// The rating summary of a page of products, as the listing computes it
POST catalog_storefront_review_default/_search
{
  "size": 0,
  "query": { "terms": { "productId": ["1239", "1431", "1607", "1"] } },
  "aggs": {
    "groups": {
      "terms": { "field": "productId", "size": 4 },
      "aggs": { "avg": { "avg": { "field": "percents" } } }
    }
  }
}

// The products with the most reviews
POST catalog_storefront_review_default/_search
{
  "size": 0,
  "aggs": { "products": { "terms": { "field": "productId", "size": 10 } } }
}

// The refresh interval that bounds how soon a write is visible to aggregations
GET catalog_storefront_product_default/_settings?filter_path=*.settings.index.refresh_interval,*.settings.index.number_of_shards
{}

// The products of a category, from core's search index: our product documents carry categoryData but do not map it
POST magento2_product_1/_search
{
  "size": 20,
  "_source": ["sku"],
  "query": { "term": { "category_ids": 3 } },
  "sort": [ { "position_category_3": "asc" } ]
}
